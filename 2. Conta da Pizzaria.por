programa {
  funcao inicio() {
    inteiro pessoas, conversao
    real valorTotal


    escreva("Digite o valor em reais R$ ")
    leia(valorTotal)

    escreva("Digite o número de pessoas:")
    leia(pessoas)

    conversao =  valorTotal/ pessoas

    escreva("A conta vai ser de R$", conversao, " reais")
  }
}
