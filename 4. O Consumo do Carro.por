programa {
  funcao inicio() {
    real kilometro, litros, mediaDeConsumo

    escreva("Digite a distância percorrida:")
    leia(kilometro)

    escreva("Digite o combustível gasto:")
    leia(litros)

    mediaDeConsumo = kilometro / litros

    escreva("A sua média de consumo é de ", mediaDeConsumo)
  }
}
